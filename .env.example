# --- Slack（部員・練習メニュー・集合欠の読み込み） ---
SLACK_BOT_TOKEN=xoxb-...
# #01_メニュー設定
SLACK_MENU_CHANNEL_ID=C01B6MF6TT6
# #01_集合欠
SLACK_ABSENCE_CHANNEL_ID=C01B0MWR10T
# 部員とみなすチャンネル（空なら、最近メニューか集合欠を投稿した人）
SLACK_MEMBER_CHANNEL_ID=

# --- Slackでサインイン ---
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# KeioMD のワークスペースID（T で始まる）。他のワークスペースの人を入れないため
SLACK_TEAM_ID=
# ランダムな文字列（32文字以上）。openssl rand -base64 32 などで作る
SESSION_SECRET=

# --- 権限（Slack のユーザーID をカンマ区切り） ---
SLACK_ADMIN_IDS=
SLACK_EDITOR_IDS=

# --- 任意 ---
# 予定を追加したときに投稿する Incoming Webhook
SLACK_WEBHOOK_URL=
# カレンダー配信（/api/calendar.ics）に ?token= を必須にする
CALENDAR_FEED_TOKEN=
